<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings of the backend suite, the command is in CLAUDE.md -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Generated migration code and the tests themselves would only dilute the numbers -->
          <Exclude>[ReviewApp.Api]ReviewApp.Api.Migrations.*,[ReviewApp.Api.Tests]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
