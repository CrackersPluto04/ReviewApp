<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds only trust the system CAs. The debug source set overrides this file
     to also trust the local ASP.NET development certificate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
