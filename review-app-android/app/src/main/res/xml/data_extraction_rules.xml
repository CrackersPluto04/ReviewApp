<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+. The session DataStore (cookie, offline mode's cached user and database keys)
     stays on this device. The offline databases are in noBackupFilesDir, never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
